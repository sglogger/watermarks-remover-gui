# Reference copy of docker-compose.yml, kept in sync and annotated with the
# variations you are most likely to want. The committed docker-compose.yml
# already works as-is; copy from here only when you need one of the changes
# described in the commented-out blocks below.
#
#   cp .env.example .env
#   docker compose up -d --build
#   open http://127.0.0.1:8080
#
# The engine is pinned by tag in .env. Upgrading is a tag bump plus
# `docker compose pull && docker compose up -d` — there is nothing to rebuild
# on the engine side, because none of its code lives in this repository.

name: watermarks-remover-gui

services:
  # Upstream engine. Referenced by image only: no build context, no source.
  wr-core:
    image: ghcr.io/guillaumemeyer/watermarks-remover:${WR_CORE_TAG:-v0.7.0}
    # Upstream publishes linux/amd64 only, so Apple Silicon and other arm64
    # hosts run it emulated. Harmless on amd64 hosts; clear WR_CORE_PLATFORM
    # once upstream ships a native arm64 image.
    platform: ${WR_CORE_PLATFORM:-linux/amd64}
    environment:
      WATERMARKS_SERVER_API_KEY: ${WATERMARKS_SERVER_API_KEY:-}
      WATERMARKS_MAX_BATCH_FILES: ${WATERMARKS_MAX_BATCH_FILES:-50}
      # Layer B, required by v0.7.0 to clean plain text and unused by every
      # other format. Empty by default, which is the published image's own
      # state: the GUI then says what to configure instead of failing blankly.
      WATERMARKS_REWRITE_BACKEND: ${WATERMARKS_REWRITE_BACKEND:-}
      WATERMARKS_REWRITE_BASE_URL: ${WATERMARKS_REWRITE_BASE_URL:-}
      WATERMARKS_REWRITE_MODEL: ${WATERMARKS_REWRITE_MODEL:-}
      WATERMARKS_REWRITE_API_KEY: ${WATERMARKS_REWRITE_API_KEY:-}
      # The engine will not talk to a non-loopback rewrite endpoint without
      # this, so that document text cannot leave the host by accident. From
      # inside the container your own host is NOT loopback, so reaching an
      # Ollama on this machine needs it set to 1.
      WATERMARKS_REWRITE_ALLOW_REMOTE: ${WATERMARKS_REWRITE_ALLOW_REMOTE:-}
      WATERMARKS_REWRITE_TEMPERATURE: ${WATERMARKS_REWRITE_TEMPERATURE:-}
      WATERMARKS_CLEAN_STRATEGY_FILE: ${WATERMARKS_CLEAN_STRATEGY_FILE:-/app/config/clean_strategy.json}
    # The engine image carries no strategy config of its own, so the default
    # Layer B strategy is mounted in read-only. Without a rewrite backend set
    # above it changes nothing — the engine still has no LLM to run it with.
    volumes:
      - ./config/clean_strategy.json:/app/config/clean_strategy.json:ro
    # Not published to the host: only wr-gui needs to reach it. Add a
    # `ports: ["127.0.0.1:8765:8765"]` mapping if you want to curl it directly.
    expose:
      - "8765"
    read_only: true
    tmpfs:
      - /tmp
    init: true
    restart: unless-stopped

  # Our frontend and proxy.
  wr-gui:
    build:
      context: .
    image: watermarks-remover-gui:local
    depends_on:
      - wr-core
    environment:
      WR_CORE_URL: http://wr-core:8765
      WATERMARKS_SERVER_API_KEY: ${WATERMARKS_SERVER_API_KEY:-}
      WR_CORE_BATCH_CAP: ${WATERMARKS_MAX_BATCH_FILES:-50}
      GUI_AUTH_TOKEN: ${GUI_AUTH_TOKEN:-}
      GUI_RATE_LIMIT_PER_MIN: ${GUI_RATE_LIMIT_PER_MIN:-0}
      GUI_MAX_UPLOAD_MB: ${GUI_MAX_UPLOAD_MB:-32}
      GUI_MAX_FILES: ${GUI_MAX_FILES:-25}
      GUI_EXIFTOOL: ${GUI_EXIFTOOL:-0}
      GUI_EXIFTOOL_TIMEOUT: ${GUI_EXIFTOOL_TIMEOUT:-20}
      GUI_EXIFTOOL_MAX_MB: ${GUI_EXIFTOOL_MAX_MB:-32}
      GUI_CACHE_TTL: ${GUI_CACHE_TTL:-600}
      GUI_CACHE_MAX_MB: ${GUI_CACHE_MAX_MB:-256}
      GUI_UPDATE_CHECK: ${GUI_UPDATE_CHECK:-1}
      GUI_LOG_LEVEL: ${GUI_LOG_LEVEL:-INFO}
    ports:
      - "${GUI_HOST_BIND:-127.0.0.1}:${GUI_HOST_PORT:-8080}:8080"
    read_only: true
    tmpfs:
      - /tmp
    init: true
    restart: unless-stopped

# ---------------------------------------------------------------------------
# Variations
# ---------------------------------------------------------------------------
#
# Reach the engine directly with curl — add to the wr-core service:
#
#   ports:
#     - "127.0.0.1:8765:8765"
#
# Serve the UI on the local network instead of this machine only — put these in
# .env, and set GUI_AUTH_TOKEN and GUI_RATE_LIMIT_PER_MIN at the same time:
#
#   GUI_HOST_BIND=0.0.0.0
#   GUI_AUTH_TOKEN=<openssl rand -base64 32>
#   GUI_RATE_LIMIT_PER_MIN=60
#
# Track the newest engine automatically instead of a pinned release. This gives
# up reproducibility: an upstream change can alter behaviour without warning,
# though the UI's contract check will report it rather than break.
#
#   WR_CORE_TAG=latest
#
# Run fully offline, with no outbound connection at all:
#
#   GUI_UPDATE_CHECK=0
#
# Native arm64, once upstream publishes such an image (today it is amd64 only,
# so arm64 hosts emulate):
#
#   WR_CORE_PLATFORM=
