# Copy to .env — docker compose loads it automatically.
# Every value below is optional; the stack runs with an empty file.

# ---------------------------------------------------------------------------
# Engine version
# ---------------------------------------------------------------------------
# The upstream engine image tag. Pinned on purpose: the GUI talks to a published
# HTTP contract, and a pinned tag means an upstream release can never change
# behaviour under you without a deliberate bump. The UI tells you when a newer
# release exists.
#
# To upgrade:  edit the tag, then `docker compose pull && docker compose up -d`.
# Note: upstream keeps only the newest version tag plus `latest`, so if a pinned
# tag has been pruned the pull fails loudly — bump to the tag the UI reports.
WR_CORE_TAG=v0.7.0

# The engine image is published for linux/amd64 only, so arm64 hosts (Apple
# Silicon, Ampere) run it under emulation — slower, but correct. Leave this
# alone unless upstream starts publishing a native arm64 image, at which point
# setting it empty picks the host architecture.
WR_CORE_PLATFORM=linux/amd64

# Per-request file cap for the engine's batch endpoints. The GUI chunks uploads
# to match, so keep both sides in step.
WATERMARKS_MAX_BATCH_FILES=50

# ---------------------------------------------------------------------------
# Layer B rewrite — required to clean PLAIN TEXT (.txt and the "Plain text" box)
# ---------------------------------------------------------------------------
# Engine v0.7.0 made a Layer B rewrite a mandatory part of cleaning plain text.
# Layer A edits characters (the invisible ones); Layer B edits wording, because
# a statistical watermark lives in word choice and survives any amount of
# character scrubbing. The engine now refuses a text clean outright, with a 400,
# rather than quietly returning text that is still marked.
#
# Nothing below is needed for Markdown, HTML, SVG, PDF, Office, EPUB or images:
# those go through the container and image pipelines, which have no Layer B.
#
# The published engine image ships no strategy config, no transformers and no
# LLM, so leaving this section empty means: everything works except cleaning
# plain text, which reports what to configure.
#
# Point the engine at an OpenAI-compatible endpoint or an Ollama server:
#   WATERMARKS_REWRITE_BACKEND=ollama
#   WATERMARKS_REWRITE_BASE_URL=http://host.docker.internal:11434
#   WATERMARKS_REWRITE_MODEL=llama3.1
#   WATERMARKS_REWRITE_ALLOW_REMOTE=1
#
# `openai-compatible` additionally needs WATERMARKS_REWRITE_API_KEY.
WATERMARKS_REWRITE_BACKEND=
WATERMARKS_REWRITE_BASE_URL=
WATERMARKS_REWRITE_MODEL=
WATERMARKS_REWRITE_API_KEY=

# The engine refuses a non-loopback rewrite endpoint unless this is set, so that
# document text is never shipped to a third party by accident. From inside the
# container, *the host is not loopback* — reaching Ollama on your own machine
# through host.docker.internal needs this set to 1.
WATERMARKS_REWRITE_ALLOW_REMOTE=

# Sampling temperature for the rewrite (engine default 0.9). Lower keeps the
# wording closer to the original; higher diverges further from the watermark.
# WATERMARKS_REWRITE_TEMPERATURE=0.9

# The strategy used when a request does not name one, as an ordered list of
# tactic@intensity steps. `config/clean_strategy.json` in this repository holds
# it, and docker-compose mounts that file into the engine read-only.
#
# Tactics: paraphrase, backtranslate, structural, humanize, code, chunk (all of
# which call the LLM above) and mlm (which needs transformers inside the engine
# image, which the published one does not have). Intensity runs from just above
# 0 to 1. The Advanced panel can override this per request.
WATERMARKS_CLEAN_STRATEGY_FILE=/app/config/clean_strategy.json

# ---------------------------------------------------------------------------
# Where the GUI listens
# ---------------------------------------------------------------------------
# Host address and port the UI is published on. 127.0.0.1 keeps it on this
# machine only; use 0.0.0.0 to expose it on the network — and then set
# GUI_AUTH_TOKEN and GUI_RATE_LIMIT_PER_MIN below.
GUI_HOST_BIND=127.0.0.1
GUI_HOST_PORT=8080

# ---------------------------------------------------------------------------
# Protection (all off by default)
# ---------------------------------------------------------------------------
# Shared secret required to use the GUI. Empty means no login at all.
# Generate one with:  openssl rand -base64 32
GUI_AUTH_TOKEN=

# Requests per minute per client address, applied to /api/ only. 0 disables it.
GUI_RATE_LIMIT_PER_MIN=0

# Bearer token the engine itself requires. Set it on both containers at once by
# filling this in; the GUI sends it and the browser never sees it.
WATERMARKS_SERVER_API_KEY=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
GUI_MAX_UPLOAD_MB=32
GUI_MAX_FILES=25

# Scan results live in memory only, so that pressing Remove does not re-upload.
# Seconds before an entry expires, and the cap on total bytes held.
GUI_CACHE_TTL=600
GUI_CACHE_MAX_MB=256

# ---------------------------------------------------------------------------
# Local metadata check (second opinion on container metadata)
# ---------------------------------------------------------------------------
# The engine runs exiftool itself, but reports back only a couple of lines it
# judged interesting: a PDF carrying /Producer, /Author and /Keywords comes back
# with "findings: []". Set this to 1 and the GUI runs its own exiftool over
# images, PDF, OOXML, ODT and EPUB after the engine's inspection, and lists the
# identifying tags it finds — and, after a removal, any that survived it.
#
# Off by default on purpose: it runs a third-party binary over untrusted
# uploads, work the engine otherwise keeps inside its own container. Bytes are
# piped in on stdin, so nothing is written to disk either way.
GUI_EXIFTOOL=0
GUI_EXIFTOOL_TIMEOUT=20
GUI_EXIFTOOL_MAX_MB=32

# ---------------------------------------------------------------------------
# Update check
# ---------------------------------------------------------------------------
# Asks the GitHub releases API once a day whether a newer engine exists, and
# shows a banner if so. This is the only outbound connection the GUI makes;
# set to 0 for a fully offline deployment.
GUI_UPDATE_CHECK=1

GUI_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Rarely needed
# ---------------------------------------------------------------------------
# How long to wait for the engine on a single request. Raise it if you scan
# very large PDFs on a slow machine.
# WR_CORE_TIMEOUT=120

# Where the GUI reaches the engine. docker compose sets this to the wr-core
# service automatically; override it only when running the two apart.
# WR_CORE_URL=http://127.0.0.1:8765

# Where the daily update check looks. Only useful for testing or for pointing
# at a mirror; GUI_UPDATE_CHECK=0 switches the check off entirely.
# GUI_RELEASES_URL=https://api.github.com/repos/guillaumemeyer/watermarks-remover/releases/latest

# Address the GUI process itself binds to *inside* its container, which is
# already correct in the image. These matter only when running it directly with
# `python3 -m app.main` instead of via docker compose — use GUI_HOST_BIND and
# GUI_HOST_PORT above for the published address.
# GUI_BIND=127.0.0.1
# GUI_PORT=8080
